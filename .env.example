# Leave PayPal keys empty to run in simulated mode (no network, SIM- ids).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: enables webhook signature verification on /api/paypal/webhook
PAYPAL_WEBHOOK_ID=
# Sandbox personal-account emails that receive Payouts
LENDER_PAYPAL_EMAIL=
BORROWER_PAYPAL_EMAIL=
# Leave empty for the deterministic offline AI fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PORT=3000
